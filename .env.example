API_HOST=0.0.0.0
API_PORT=8000
WALLET_RISK_IMAGE=wallet-risk-api:local

# Use "disabled" for deterministic local smoke tests.
# Use "ollama" when local Ollama is running and OLLAMA_MODEL is available.
AGENT_LLM_PROVIDER=disabled
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
AGENT_LLM_TIMEOUT_SECONDS=120
AGENT_LLM_NUM_PREDICT=512

AGENT_MAX_STEPS=8
AGENT_TOOL_TIMEOUT_SECONDS=3
EXPLANATION_DIR=monitoring/explanations
